# 复制为 docker/.env 并填入真实凭据；docker/.env 已被 gitignore。
# 这些值只会注入容器（compose 插值），不会写进镜像或仓库。
# 要按平台分开管理，用 docker/envs/<platform>.env.example + --env-file（见 docker/README.md）。

# 平台：aliyun（默认）/ tencent / deepseek / kimi / glm
# 换平台时建议同时按下方参考调整 URL 与模型。
#
# E2E_BASE_URL / E2E_CLAUDE_BASE_URL 的填法：
#   deepseek / kimi / glm —— 两项都可留空，CLI 会用内置预设
#   aliyun / tencent      —— E2E_BASE_URL 必填（无预设）；E2E_CLAUDE_BASE_URL 可选
# 各平台预设参考：
#   aliyun   https://dashscope.aliyuncs.com/compatible-mode/v1
#            https://dashscope.aliyuncs.com/apps/anthropic
#   deepseek https://api.deepseek.com
#            https://api.deepseek.com/anthropic
#   kimi     https://api.moonshot.cn/v1（国际站 api.moonshot.ai）
#            https://api.moonshot.cn/anthropic
#   glm      https://open.bigmodel.cn/api/coding/paas/v4（Coding Plan）
#            https://open.bigmodel.cn/api/anthropic
#   tencent  TokenHub 地址由控制台给出，平台无预设
E2E_PLATFORM=aliyun

# 真实 API token（必填）
E2E_TOKEN=

# OpenAI 兼容根地址（aliyun/tencent 必填；deepseek/kimi/glm 可留空用预设）
E2E_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Anthropic 兼容根地址（可选；留空则回退 E2E_BASE_URL）
E2E_CLAUDE_BASE_URL=https://dashscope.aliyuncs.com/apps/anthropic

# 默认模型 id：留空则自动取 profile 拉到的 models 第一项
E2E_MODEL=

# 发往四个工具的最小 prompt（只验证连通性）
E2E_PROMPT=只回复 pong，不要调用任何工具。

# profile 名称（A/B 各自创建；switch 用第二个）
E2E_PROFILE_NAME=e2e
E2E_SWITCH_PROFILE_NAME=e2e-switch

# 每条真实调用的超时（秒）
E2E_TIMEOUT=120

# token-server 监听端口（仅 B 用；默认 8787）
E2E_SERVER_PORT=8787
