# DeepSeek。自包含：所有变量都在本文件里显式给出，
# 显式空值会覆盖掉 docker/.env 的同名变量，避免串台。
#
#   cp docker/envs/deepseek.env.example docker/envs/deepseek.env   # 填 E2E_TOKEN
#   docker compose -f docker/docker-compose.yml --env-file docker/envs/deepseek.env run --rm a-config-use

E2E_PLATFORM=deepseek

# 必填：真实 API token
E2E_TOKEN=

# 空 = 用 CLI 内置预设（https://api.deepseek.com 与 https://api.deepseek.com/anthropic）
E2E_BASE_URL=
E2E_CLAUDE_BASE_URL=

# 空 = 自动取 profile 拉到的模型列表第一项
E2E_MODEL=

# 空 = 脚本内默认值（prompt「只回复 pong，不要调用任何工具。」、profile 名 e2e / e2e-switch、超时 120s、端口 8787）
E2E_PROMPT=
E2E_PROFILE_NAME=
E2E_SWITCH_PROFILE_NAME=
E2E_TIMEOUT=
E2E_SERVER_PORT=
